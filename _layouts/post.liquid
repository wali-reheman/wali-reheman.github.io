---
layout: default
---
{% assign year = page.date | date: '%Y' %}
{% assign tags = page.tags | join: '' %}
{% assign categories = page.categories | join: '' %}
{% assign read_time = page.content | number_of_words | divided_by: 180 | plus: 1 %}
{% assign primary_label = '' %}
{% assign primary_type = '' %}
{% if page.tags and page.tags.size > 0 %}
  {% assign primary_label = page.tags[0] %}
  {% assign primary_type = 'tag' %}
{% elsif page.categories and page.categories.size > 0 %}
  {% assign primary_label = page.categories[0] %}
  {% assign primary_type = 'category' %}
{% endif %}

{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

{% assign url_beginning = page.url | slice: 0, 6 %}

<div class="post">
  <header class="post-header">
    {% if url_beginning == '/blog/' %}
      <a class="post-back-link" href="{{ '/blog/' | relative_url }}">Back to Posts</a>
    {% endif %}
    <h1 class="post-title">{{ page.title }}</h1>
    {% if page.description and page.description != '' %}
      <p class="post-dek">{{ page.description }}</p>
    {% endif %}
    <p class="post-meta">
      {{ page.date | date: '%B %d, %Y' }}
      &nbsp; &middot; &nbsp; {{ read_time }} min read
      {% if primary_label != '' %}
        &nbsp; &middot; &nbsp;
        {% if primary_type == 'tag' %}
          # {{ primary_label }}
        {% else %}
          {{ primary_label }}
        {% endif %}
      {% endif %}
      {% if page.author %}by {{ page.author }}{% endif %}
      {% if page.last_updated %}, last updated in {{ page.last_updated | date: '%B %d, %Y' }}{% endif %}
      {% if page.meta %}• {{ page.meta }}{% endif %}
    </p>
  </header>

  <div class="{% if url_beginning == '/blog/' %}post-reading-layout{% endif %}">
    <article class="post-content">
      {% if page.toc and page.toc.beginning %}
        <div id="table-of-contents">
          {% toc %}
        </div>
        <hr>
      {% endif %}
      <div id="markdown-content">
        {{ content }}
      </div>
    </article>

    {% if url_beginning == '/blog/' %}
      <aside class="post-toc-panel" aria-label="Article table of contents">
        <div class="post-toc-panel__inner">
          <div class="post-toc-panel__label">On this page</div>
          <div class="post-toc-progress" aria-hidden="true">
            <span id="post-toc-progress-bar"></span>
          </div>
          <nav id="post-dynamic-toc"></nav>
        </div>
      </aside>
    {% endif %}
  </div>

  {% if page.citation %}
    {% include citation.liquid %}
  {% endif %}

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.related_blog_posts.enabled %}
    {% if page.related_posts == null or page.related_posts %}
      {% include related_posts.liquid %}
    {% endif %}
  {% endif %}

  {% if site.disqus_shortname and page.disqus_comments %}
    {% include disqus.liquid %}
  {% endif %}
  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>

{% if url_beginning == '/blog/' %}
  <script>
    (() => {
      const content = document.querySelector('#markdown-content');
      const toc = document.querySelector('#post-dynamic-toc');
      const progressBar = document.querySelector('#post-toc-progress-bar');
      if (!content || !toc || !progressBar) return;

      const headings = Array.from(content.querySelectorAll('h2, h3')).filter((heading) => heading.textContent.trim());
      if (!headings.length) {
        const panel = document.querySelector('.post-toc-panel');
        if (panel) panel.remove();
        return;
      }

      const slugCounts = new Map();
      const slugify = (text) => {
        const base =
          text
            .toLowerCase()
            .trim()
            .replace(/[^a-z0-9\u4e00-\u9fff]+/g, '-')
            .replace(/^-+|-+$/g, '') || 'section';
        const count = slugCounts.get(base) || 0;
        slugCounts.set(base, count + 1);
        return count ? `${base}-${count + 1}` : base;
      };

      headings.forEach((heading) => {
        if (!heading.id) heading.id = slugify(heading.textContent);
        const link = document.createElement('a');
        link.href = `#${heading.id}`;
        link.textContent = heading.textContent;
        link.className = `post-toc-link post-toc-link--${heading.tagName.toLowerCase()}`;
        link.addEventListener('click', (event) => {
          event.preventDefault();
          heading.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.replaceState(null, '', `#${heading.id}`);
        });
        toc.appendChild(link);
      });

      const tocLinks = Array.from(toc.querySelectorAll('a'));
      const setActive = () => {
        const offset = 120;
        let activeIndex = 0;
        headings.forEach((heading, index) => {
          if (heading.getBoundingClientRect().top - offset <= 0) activeIndex = index;
        });
        tocLinks.forEach((link, index) => link.classList.toggle('is-active', index === activeIndex));
      };

      const updateProgress = () => {
        const rect = content.getBoundingClientRect();
        const total = Math.max(content.offsetHeight - window.innerHeight * 0.55, 1);
        const read = Math.min(Math.max(-rect.top + 80, 0), total);
        progressBar.style.width = `${(read / total) * 100}%`;
        setActive();
      };

      updateProgress();
      window.addEventListener('scroll', updateProgress, { passive: true });
      window.addEventListener('resize', updateProgress);
    })();
  </script>
{% endif %}
