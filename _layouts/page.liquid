---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    {% if page.project_intro %}
      {% include project_intro.liquid img=page.img title=page.title icons=page.icons description=page.description %}
      <hr>
      {% if page.repository %}
        <div class="repositories d-flex flex-wrap flex-md-row flex-column justify-content-between align-items-center">
          {% for repo in page.repository %}
            {% include repository/repo.liquid repository=repo %}
          {% endfor %}
        </div>
        <hr>
      {% endif %}
    {% else %}
      <div class="row align-items-start post-hero-row">
        <div class="col-lg-9 col-md-8">
          <h1 class="post-title">{{ page.title }}</h1>
          <p class="post-description">{{ page.description }}</p>
        </div>
        <div class="col-lg-3 col-md-4 d-none d-md-block">
          <div class="post-hero-portrait">
            <img
              src="{{ site.profile.image | default: '/assets/img/profile.png' | relative_url }}"
              class="post-hero-image"
              alt="Profile"
            >
          </div>
        </div>
      </div>
    {% endif %}
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
