---
layout: default
---
<section class="owl-banner" aria-label="Site banner"></section>

<div class="owl-page owl-page--home">
  {% include owl_profile.liquid profile_image=page.profile.image role=page.eyebrow %}

  <main class="owl-main" id="content">
    <article>
      <div class="clearfix">{{ content }}</div>
    </article>

    {% if site.latest_posts.enabled %}
      <section class="owl-extra-block">
        <h2 class="home-block__title"><a href="{{ '/blog/' | relative_url }}">Posts</a></h2>
        {% include latest_posts.liquid %}
      </section>
    {% endif %}

    {% if page.news and site.announcements.enabled %}
      <section class="owl-extra-block home-news">
        <h2 class="home-block__title"><a href="{{ '/news/' | relative_url }}">News</a></h2>
        {% include news.liquid limit=true %}
      </section>
    {% endif %}
  </main>
</div>
